# Support relocatable installs (AppImage): look up the OpenXR runtime
# manifest relative to the executable, and look for the bundled xrizer in
# ../lib/xrizer.
--- a/server/active_runtime.cpp
+++ b/server/active_runtime.cpp
@@ -57,6 +57,11 @@
 	if (std::filesystem::exists(dev_manifest))
 		return {dev_manifest};
 
+	// Check relative to the executable, for relocatable installs
+	auto relative_location = (exe.parent_path() / ".." / location).lexically_normal();
+	if (std::filesystem::exists(relative_location))
+		return filter_files(relative_location, prefix);
+
 	// Assume we are installed
 	return filter_files(WIVRN_INSTALL_PREFIX / location, prefix);
 }
